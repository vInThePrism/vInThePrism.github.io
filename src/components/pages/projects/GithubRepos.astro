---
/**
 * Bottom of the Projects page: public repos synced from GitHub.
 * Data is written to src/constants/github-repos.json by scripts/sync-github-repos.ts at build time;
 * GitHub Actions rebuilds daily, so this list keeps up with GitHub automatically.
 */
import { Icon } from "astro-icon/components";
import data from "@/constants/github-repos.json";

interface Repo {
	name: string;
	fullName: string;
	url: string;
	description: string;
	language: string;
	stars: number;
	forks: number;
	fork: boolean;
	pushedAt: string;
	topics: string[];
	homepage: string;
}

const repos = (data.repos as Repo[]).slice(0, 24);
const own = repos.filter((r) => !r.fork);
const forks = repos.filter((r) => r.fork);

const langColor: Record<string, string> = {
	Python: "#3572A5",
	"C++": "#f34b7d",
	C: "#555555",
	Cuda: "#3A4E3A",
	TypeScript: "#3178c6",
	JavaScript: "#f1e05a",
	Astro: "#ff5a03",
	Rust: "#dea584",
	Go: "#00ADD8",
	Shell: "#89e051",
	"Jupyter Notebook": "#DA5B0B",
	HTML: "#e34c26",
	CSS: "#663399",
	Svelte: "#ff3e00",
};

function relTime(iso: string): string {
	if (!iso) return "";
	const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86400000);
	if (days < 1) return "today";
	if (days < 30) return `${days} day${days === 1 ? "" : "s"} ago`;
	if (days < 365) {
		const m = Math.floor(days / 30);
		return `${m} month${m === 1 ? "" : "s"} ago`;
	}
	const y = Math.floor(days / 365);
	return `${y} year${y === 1 ? "" : "s"} ago`;
}

const groups = [
	{ title: "My Repositories", icon: "fa7-brands:github", items: own },
	{ title: "Forks I Contribute To", icon: "material-symbols:fork-right", items: forks },
].filter((g) => g.items.length > 0);
---

{
	groups.length > 0 && (
		<section class="github-repos mt-4 flex flex-col gap-4">
			{groups.map((g) => (
				<div>
					<div class="card-base px-6 py-4 mb-3 flex items-center justify-between gap-3">
						<div class="flex items-center gap-2 font-bold text-lg text-black/80 dark:text-white/80">
							<Icon name={g.icon} class="text-(--primary) text-xl" />
							{g.title}
							<span class="text-sm font-normal text-black/40 dark:text-white/40">
								· {g.items.length}
							</span>
						</div>
						<a
							href={`https://github.com/${data.user}?tab=repositories`}
							target="_blank"
							rel="noopener noreferrer"
							class="text-sm text-(--primary) hover:underline"
						>
							View all on GitHub →
						</a>
					</div>
					<div class="grid gap-3 grid-cols-1 md:grid-cols-2">
						{g.items.map((r) => (
							<a
								href={r.url}
								target="_blank"
								rel="noopener noreferrer"
								class="card-base repo-card group p-4 flex flex-col gap-2 transition hover:-translate-y-0.5"
							>
								<div class="flex items-center gap-2 min-w-0">
									<Icon
										name="material-symbols:book-2-outline-rounded"
										class="text-(--primary) text-lg shrink-0"
									/>
									<span class="font-bold truncate text-black/80 dark:text-white/85 group-hover:text-(--primary) transition">
										{r.name}
									</span>
								</div>
								<p class="text-sm text-black/55 dark:text-white/55 line-clamp-2 min-h-[2.5em]">
									{r.description || "No description yet."}
								</p>
								<div class="flex items-center gap-4 text-xs text-black/45 dark:text-white/45 mt-auto">
									{r.language && (
										<span class="flex items-center gap-1.5">
											<span
												class="w-2.5 h-2.5 rounded-full inline-block"
												style={`background:${langColor[r.language] ?? "var(--primary)"}`}
											/>
											{r.language}
										</span>
									)}
									{r.stars > 0 && (
										<span class="flex items-center gap-1">
											<Icon name="material-symbols:star-rounded" />
											{r.stars}
										</span>
									)}
									<span class="ml-auto">Updated {relTime(r.pushedAt)}</span>
								</div>
							</a>
						))}
					</div>
				</div>
			))}
			{data.updatedAt && (
				<p class="text-xs text-center text-black/35 dark:text-white/35">
					Synced automatically from GitHub · last sync {data.updatedAt.slice(0, 10)}
				</p>
			)}
		</section>
	)
}
